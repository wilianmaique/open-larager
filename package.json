{
  "name": "open-larager",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle -- --locked",
    "desktop:bundle": "tauri build --bundles nsis -- --locked",
    "release:version": "node scripts/release-version.mjs set",
    "release:check": "node scripts/release-version.mjs check",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "format": "prettier --write src tests scripts *.json *.ts",
    "format:check": "prettier --check src tests scripts *.json *.ts",
    "catalog:refresh": "node scripts/refresh-catalog.mjs && node scripts/refresh-php-extensions.mjs",
    "catalog:extensions": "node scripts/refresh-php-extensions.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.12.4",
    "lucide-react": "1.61.0",
    "monaco-editor": "0.57.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
